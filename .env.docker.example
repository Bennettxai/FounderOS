# FounderOS (on GladOS) - Docker/Coolify Environment Variables
# Copy this to .env and fill in your values, or set them in Coolify's environment variables UI

# =============================================================================
# CORE APP SETTINGS
# =============================================================================
# The URL your app will be accessible at (used for OAuth callbacks, webhooks, etc.)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Brand: "founderos" (default) or "glados"
GLADOS_BRAND=founderos

# Default mode for fresh installs: "demo" (demo company) or "real" (blank)
GLADOS_DEFAULT_MODE=demo

# Operator name shown across the OS
GLADOS_OPERATOR_NAME=Operator

# =============================================================================
# SECURITY (Set via UI at /setup after first deploy)
# =============================================================================
# DO NOT SET THESE MANUALLY - they are written by the app when you set a password
# at /setup → Security. The app generates a secure hash and session secret.
# GLADOS_PASSWORD_HASH=
# GLADOS_SESSION_SECRET=

# =============================================================================
# EMAIL (IMAP) - Configure up to 4 inboxes
# =============================================================================
# Inbox 1 (primary)
INBOX_1_HOST=imap.gmail.com
INBOX_1_USER=your-email@gmail.com
INBOX_1_PASS=your-app-password
INBOX_1_NAME=Primary
INBOX_1_PORT=993

# Inbox 2 (optional)
# INBOX_2_HOST=
# INBOX_2_USER=
# INBOX_2_PASS=
# INBOX_2_NAME=

# Inbox 3 (optional)
# INBOX_3_HOST=
# INBOX_3_USER=
# INBOX_3_PASS=
# INBOX_3_NAME=

# Inbox 4 (optional)
# INBOX_4_HOST=
# INBOX_4_USER=
# INBOX_4_PASS=
# INBOX_4_NAME=

# =============================================================================
# SLACK
# =============================================================================
# Bot token (xoxb-...) with scopes: channels:read, channels:history, users:read
SLACK_BOT_TOKEN=

# =============================================================================
# RECORDINGS
# =============================================================================
# Plaud ingest token (any long random string)
PLAUD_INGEST_TOKEN=

# Fathom API key (read-only meeting list)
FATHOM_API_KEY=

# =============================================================================
# PAYMENT PROCESSORS
# =============================================================================
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
SQUARE_ACCESS_TOKEN=
WHOP_API_KEY=

# =============================================================================
# TRADING
# =============================================================================
# Token for Markets agent to push snapshots
TRADING_PUSH_TOKEN=

# Phantom wallet address (public Solana address only)
PHANTOM_WALLET_ADDRESS=

# Solana RPC URL
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# =============================================================================
# USAGE TRACKING
# =============================================================================
USAGE_PUSH_TOKEN=
CLAUDE_PROJECTS_DIR=/root/.claude/projects
CODEX_SESSIONS_DIR=/root/.codex/sessions
GLADOS_USAGE_MACHINE=founderos

# =============================================================================
# CLIENTS / SUPERSET
# =============================================================================
SUPERSET_API_KEY=
SUPERSET_BIN=superset
SUPERSET_PROJECT_ID=

# =============================================================================
# NOTION
# =============================================================================
NOTION_API_KEY=

# =============================================================================
# OFFER FUNNEL (GOHIGHLEVEL)
# =============================================================================
WEBINARJAM_API_KEY=
TRAKYO_API_KEY=
TRAKYO_ACCOUNT_ID=
GHL_API_KEY=
GHL_LOCATION_ID=

# =============================================================================
# G-BRAIN
# =============================================================================
BRAIN_PROVIDER=gbrain
GBRAIN_BIN=gbrain
GBRAIN_STORE=/data/brain-store
# GBRAIN_DISABLE_DIRECT_POOL=1

# =============================================================================
# LLM (VERCEL AI GATEWAY)
# =============================================================================
AI_GATEWAY_API_KEY=
LLM_PROVIDER=gateway
LLM_MODEL=anthropic/claude-sonnet-4-6

# =============================================================================
# BEEHIIV
# =============================================================================
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# =============================================================================
# MANYCHAT
# =============================================================================
MANYCHAT_API_KEY=
MANYCHAT_WEBHOOK_SECRET=

# =============================================================================
# FINANCES (ADDITIONAL PAYMENT PROCESSORS)
# =============================================================================
FANBASIS_KEY_1=
FANBASIS_KEY_2=
WISE_1_TOKEN=
WISE_2_TOKEN=

# =============================================================================
# EMAIL SEND (SMTP)
# =============================================================================
INBOX_1_SMTP_HOST=smtp.gmail.com
INBOX_1_SMTP_PORT=465

# =============================================================================
# COMMS LANE ROUTING
# =============================================================================
COMMS_WORK_KEYWORDS=

# =============================================================================
# APP FLAGS
# =============================================================================
GLADOS_WARM=1
GLADOS_SWR=1
# GLADOS_WRITES=1  # Enable outbound launches (Superset drafts, Trakyo links)
# GLADOS_CRON=1    # Run scheduled agent jobs (ONE always-on host only)

# =============================================================================
# WHATSAPP (SENDING ONLY)
# =============================================================================
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# =============================================================================
# CREATIVE ENGINE
# =============================================================================
FOREPLAY_API_KEY=
MIOSA_API_KEY=
ARCADS_BASIC_AUTH=
# CREATIVE_ENGINE_DRY=1
CREATIVE_ENGINE_CREDIT_CAP=200
CREATIVE_ENGINE_STORE_DIR=/data/creative-engine
CREATIVE_ENGINE_ASSET_DIR=/app/public/content-media/creative-engine

# =============================================================================
# CONTENT LAB
# =============================================================================
APIFY_API_TOKEN=
OPENAI_API_KEY=
LAB_YT_CLIENT_ID=
LAB_YT_CLIENT_SECRET=
LAB_YT_REFRESH_TOKEN=
LAB_YT_CHANNEL_ID=
LAB_YT_CONNECTED_AT=
LAB_YT_REDIRECT_URI=
LAB_IG_APP_ID=
LAB_IG_APP_SECRET=
LAB_IG_ACCESS_TOKEN=
LAB_IG_TOKEN_EXPIRES_AT=
LAB_IG_USER_ID=
LAB_IG_REDIRECT_URI=
PRODUCTHUNT_TOKEN=
GITHUB_TOKEN=

# Spend caps (USD/month)
LAB_APIFY_CAP_USD=98
LAB_APIFY_SYNC_CAP_USD=46
LAB_APIFY_SNAPSHOTS_CAP_USD=22
LAB_APIFY_X_CAP_USD=10
LAB_APIFY_VERIFY_CAP_USD=1
LAB_APIFY_RADAR_X_CAP_USD=15
LAB_APIFY_RADAR_TIKTOK_CAP_USD=3
LAB_APIFY_RADAR_PRODUCTHUNT_CAP_USD=1
LAB_STT_CAP_USD=13
LAB_STT_CONTROLS_CAP_USD=3
LAB_COMMENTS_CAP_USD=0
LAB_DOWNLOADS_CAP_USD=0
LAB_EMBED_CAP_USD=0
LAB_RUN_MAX_USD=3

# Feature flags
# LAB_COMMENTS=1
# LAB_TIKTOK_DOWNLOADS=1
LAB_TIKTOK_DOWNLOAD_PRICE_USD=
LAB_EMBED_PROVIDER=local
# LAB_FRAMES=1
# LAB_JUDGE=1
LAB_JUDGE_MODEL=
LAB_GROUNDING_CONTROL=0
LAB_COMMENT_SALT=
LAB_X_POLL_MIN=120
# LAB_BRIEF_TELEGRAM=1
GLADOS_TZ=
# LAB_DRY=1
LAB_FIXTURE_SCENARIO=full
LAB_SYNC_WAIT_MIN=20
LAB_DISSECT_MODEL=

# =============================================================================
# AGENT HEALTH CHECKS
# =============================================================================
BDPILOT_STATE=/root/.config/bdpilot/state.json
BDPILOT_BOT_URL=
BRAND_DEALS_SKILL=/root/.claude/skills/brand-deals/SKILL.md
GSEND_BIN=/root/bin/gsend
GSEND_QUEUE_PLIST=
GLADOS_AUTOMATION_DIR=/data/Automation
GLADOS_AGENT_JOB_PREFIX=glados.agent.