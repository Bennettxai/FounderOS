# ─────────────────────────────────────────────────────────────────────────────
# OptimalEngine — environment variable reference
#
# Copy this file to .env (dev) or .env.prod (production) and fill in the
# values. Never commit either of those files.
#
# docker-compose.yml reads variables from the *shell environment* and the
# optional .env file in the same directory. docker-compose.prod.yml reads
# from .env.prod via `env_file:`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Engine ───────────────────────────────────────────────────────────────────

# Port the engine HTTP API listens on inside the container (also the host
# port exposed in the dev compose file).
# Default: 4200
OPTIMAL_API_PORT=4200

# Set to "true" to require authentication on all API calls.
# PRODUCTION MUST SET THIS TO "true".
# Default: false
OPTIMAL_AUTH_REQUIRED=false

# Filesystem path inside the container where the engine reads/writes data.
# Mapped from the `optimal_data` named volume.
# Default: /data
OPTIMAL_ENGINE_ROOT=/data

# SQLite database path inside the container.
# Default: /data/.optimal/index.db
OPTIMAL_ENGINE_DB=/data/.optimal/index.db

# Cache/index path inside the container.
# Default: /data/.optimal/cache
OPTIMAL_ENGINE_CACHE=/data/.optimal/cache

# Ollama base URL for embedding and generation requests.
# `host.docker.internal` resolves to the host machine from inside a container
# on Docker Desktop (Mac/Windows). On Linux use the host's LAN IP or run
# Ollama as a compose service.
# Default: http://host.docker.internal:11434
OPTIMAL_OLLAMA_URL=http://host.docker.internal:11434

# ── Optional storage providers ──────────────────────────────────────────────
# Leave these unset for the default local-first engine. Set them when a
# workspace policy activates the corresponding self-hosted or cloud provider.

# Canonical multi-user relational store target.
# OPTIMAL_POSTGRES_URL=postgres://optimal:change-me@postgres:5432/optimal

# S3-compatible raw artifact and backup storage.
# OPTIMAL_S3_ENDPOINT=http://garage:3900
# OPTIMAL_S3_BUCKET=optimal-artifacts
# OPTIMAL_S3_ACCESS_KEY_ID=
# OPTIMAL_S3_SECRET_ACCESS_KEY=

# Distributed event replay, jobs, and workspace mutation transport.
# OPTIMAL_NATS_URL=nats://nats:4222

# Distributed cache, leases, quotas, and short-lived coordination.
# OPTIMAL_VALKEY_URL=redis://valkey:6379

# Scalable vector projection. Keep unset while embedded vectors meet SLOs.
# OPTIMAL_QDRANT_URL=http://qdrant:6333
# OPTIMAL_QDRANT_API_KEY=

# Local analytical projection directory used by DuckDB and Parquet exports.
# OPTIMAL_ANALYTICS_PATH=/data/.optimal/analytics

# Production secrets and encryption provider.
# OPTIMAL_OPENBAO_ADDR=http://openbao:8200
# OPTIMAL_OPENBAO_TOKEN=

# Enterprise partner substrate. Store only a secret-manager reference here,
# not raw long-lived credentials.
# OPTIMAL_FRACTAL_ENDPOINT=
# OPTIMAL_FRACTAL_CREDENTIAL_REF=openbao://secret/data/fractal

# ── Optional surface ports (only with `--profile surfaces`) ──────────────────

# Host port for the desktop UI
# Default: 1420
DESKTOP_PORT=1420

# Host port for the marketing site
# Default: 1421
SITE_PORT=1421

# Host port for the docs site
# Default: 1422
DOCS_PORT=1422

# ── Production TLS (required for docker-compose.prod.yml) ────────────────────

# Your fully-qualified domain name. Caddy will request a Let's Encrypt
# certificate for this domain and its www./docs. subdomains automatically.
# Ensure DNS A records point at this server BEFORE first run.
# DOMAIN=optimal.example.com

# Email address registered with Let's Encrypt for certificate expiry notices.
# LETSENCRYPT_EMAIL=admin@example.com
