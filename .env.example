# FounderOS (on GladOS): copy to .env.local and fill in. .env.local is gitignored.

# ── Sign-in ──────────────────────────────────────────────────────────────
# Nothing to type here. Start the app, open http://localhost:4100/setup and
# set an operator password under Security. GladOS writes
# GLADOS_PASSWORD_HASH and GLADOS_SESSION_SECRET into this file itself.
# Until a password exists the server listens on 127.0.0.1 only and refuses
# any other GLADOS_HOST. Forgot it: delete the GLADOS_PASSWORD_HASH line,
# restart, set a new one.
# GLADOS_HOST=                # bind address once a password is set (a Tailscale IP, 0.0.0.0)
# GLADOS_BRAND=               # unset = FounderOS (the client product); glados = the operator's own GladOS instance
# GLADOS_TRUSTED_HOSTS=       # comma list of names that resolve to THIS machine (e.g. a filming alias in /etc/hosts); ignored once a password is set
# PORT=4100
GLADOS_OPERATOR_NAME=        # optional: the name shown across the OS (default "Operator")
# GLADOS_DEFAULT_MODE=real    # a fresh clone opens on the demo company (demo-data/); set real to start blank (data/)

# ── Email (up to 4 IMAP inboxes) ─────────────────────────────────────────
# Gmail: use an App Password (Google Account → Security → 2FA → App passwords)
INBOX_1_HOST=imap.gmail.com
INBOX_1_USER=
INBOX_1_PASS=
INBOX_1_NAME=
# INBOX_1_PORT=993            # optional, defaults to 993
INBOX_2_HOST=
INBOX_2_USER=
INBOX_2_PASS=
INBOX_3_HOST=
INBOX_3_USER=
INBOX_3_PASS=
INBOX_4_HOST=
INBOX_4_USER=
INBOX_4_PASS=

# ── Slack ────────────────────────────────────────────────────────────────
# Bot token (xoxb-…) with scopes: channels:read, channels:history, users:read
SLACK_BOT_TOKEN=

# ── Recordings (Comms → Recordings) ──────────────────────────────────────
# Plaud does not get polled: a relay POSTs finished recordings to
# /api/plaud/ingest with `Authorization: Bearer <PLAUD_INGEST_TOKEN>`.
PLAUD_INGEST_TOKEN=          # any long random string you choose; leave blank to accept only your own session
FATHOM_API_KEY=              # Fathom → Settings → API; read-only meeting list, cached 10 min
# VIDALYTICS_API_KEY=        # Vidalytics → Settings → API; catalogue entry only, nothing reads it yet (T10)

# ── Payment processors ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=            # full client implemented (balance + charges)
PAYPAL_CLIENT_ID=             # registered; client lands when keys do
PAYPAL_CLIENT_SECRET=
SQUARE_ACCESS_TOKEN=
WHOP_API_KEY=

# ── Trading (/trading) ───────────────────────────────────────────────────
# Robinhood has no key here: the Markets agent (Robinhood MCP, elsewhere) pushes
# snapshots to POST /api/trading/snapshot with `Authorization: Bearer <TRADING_PUSH_TOKEN>`.
# GladOS never places orders. Phantom reads a PUBLIC address only.
TRADING_PUSH_TOKEN=          # any long random string you choose; shared with the Markets agent
PHANTOM_WALLET_ADDRESS=      # Solana address (public, not a key; nothing can be signed)
# SOLANA_RPC_URL=            # optional; default https://api.mainnet-beta.solana.com (free getBalance)

# ── Usage (/usage) ───────────────────────────────────────────────────────
# Reads this machine's ~/.claude and ~/.codex transcripts (off on demo and filming
# instances). Other machines push their readings to POST /api/usage/push.
USAGE_PUSH_TOKEN=            # any long random string; shared with the pushing machines
# CLAUDE_PROJECTS_DIR=       # default ~/.claude/projects
# CODEX_SESSIONS_DIR=        # default ~/.codex/sessions
# GLADOS_USAGE_MACHINE=      # this machine's name in the usage board (default: hostname)

# ── Clients (/clients) ───────────────────────────────────────────────────
SUPERSET_API_KEY=            # handed to the superset CLI when a client draft is launched
# SUPERSET_BIN=              # default `superset` on PATH
# SUPERSET_PROJECT_ID=       # default project for launches when a client has none

# ── Notion ───────────────────────────────────────────────────────────────
# Internal integration secret; share target pages with the integration
NOTION_API_KEY=

# ── Offer funnel (GoHighLevel) ───────────────────────────────────────────────────
WEBINARJAM_API_KEY=          # account-wide key; pulls webinar registrants/attendees
TRAKYO_API_KEY=              # Trakyo API v1 (tky_live_…): funnel attribution + the link studio
# TRAKYO_ACCOUNT_ID=         # optional: agency keys only, sent as X-Trakyo-Account on reads
GHL_API_KEY=                 # GoHighLevel Private Integration token (Settings → Private Integrations, read scopes)
GHL_LOCATION_ID=             # the sub-account location id (visible in the GHL URL: /v2/location/<id>/…)

# ── G-Brain ──────────────────────────────────────────────────────────────
# Defaults work: gbrain CLI on PATH, store at knowledge/brain-store
# BRAIN_DIR=~/Desktop/brain  # the brain folder the Database page maps (default ~/Desktop/brain, then ~/Sync/brain)
# BRAIN_PROVIDER=gbrain       # set to "stub" to disable
# GBRAIN_BIN=                 # override CLI path
# GBRAIN_STORE=               # override brain-store path
# GBRAIN_DISABLE_DIRECT_POOL=1

# ── LLM (agent & Conductor chat via Vercel AI Gateway) ───────────────────
# Without a key, agent chat reports "not configured" (no fake "connected").
AI_GATEWAY_API_KEY=           # Vercel AI Gateway key; enables agent chat
# LLM_PROVIDER=gateway        # set to "stub" for deterministic offline tests
# LLM_MODEL=anthropic/claude-sonnet-4-6   # "provider/model" routed via gateway

# ── Agent web research (Parallel Search MCP) ─────────────────────────────
# Default: free anonymous search + page fetching in agent chat.
# WEB_SEARCH_PROVIDER=parallel # set to none (or blank) to disable all web tools
# PARALLEL_API_KEY=            # optional: use your Parallel account's limits

# ── Beehiiv (email list) ─────────────────────────────────────────────────
# Without both, the Social email-list card stays seeded dummy (no fake number).
BEEHIIV_API_KEY=             # Beehiiv API key
BEEHIIV_PUBLICATION_ID=      # publication id (pub_...)

# ── ManyChat (Instagram DM automation) ───────────────────────────────────
# Lights up the ManyChat connector on /integrations. ManyChat → Settings → API.
# The API cannot list DMs — the live /social DM inbox is fed by the webhook
# below, not by this key.
MANYCHAT_API_KEY=            # ManyChat API key
# Optional shared secret: if set, /api/webhooks/manychat requires header
# `x-manychat-secret` to match (put the same value in the ManyChat External
# Request headers). Leave blank to accept unauthenticated posts (dev only).
MANYCHAT_WEBHOOK_SECRET=

# ── Payments processors (Finances) ───────────────────────────────────────
# Stripe is fully wired; the rest are honest "not configured" until keyed.
# STRIPE_SECRET_KEY=         # sk_live_… / sk_test_… (already above if set)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
FANBASIS_KEY_1=             # FanBasis · first account
FANBASIS_KEY_2=             # FanBasis · second account
WISE_1_TOKEN=                # Wise account 1 (income + outgoing transfers)
WISE_2_TOKEN=                # Wise account 2

# ── Email send (SMTP, optional per inbox) ────────────────────────────────
# Comms email replies send for real via SMTP using each inbox's user/pass.
# Defaults: host = INBOX_n_HOST with imap.→smtp., port 465. Override per slot:
# INBOX_1_SMTP_HOST=smtp.gmail.com
# INBOX_1_SMTP_PORT=465

# ── Comms lane routing (optional) ────────────────────────────────────────
# Extra keywords that force a message into the /comms Work lane, comma-separated,
# matched against its inbox / sender / subject. Add your brands + key clients.
# Generic work signals (invoice, contract, proposal, …) are built in.
# COMMS_WORK_KEYWORDS=Acme,Northwind,Jane Client

# ── App ──────────────────────────────────────────────────────────────────
# GLADOS_DB=              # override SQLite path
# GLADOS_WARM=0           # skip the live-read cache warm-up at server start (lib/warm.ts)
# GLADOS_SWR=0            # turn the live-read cache off entirely (every render calls every source)
# NEXT_DIST_DIR=          # build folder; `npm run preview` uses .next-preview
# Operator switches (FounderOS merge, both OFF unless exactly 1; filming forces them off):
GLADOS_WRITES=            # 1 = allow outbound launches (Superset drafts, Trakyo links); each still needs a confirm
GLADOS_CRON=              # 1 = run scheduled agent jobs from this process every 60s. ONE always-on host only

# WhatsApp — SENDING only (reading uses the local desktop app, no keys needed).
# Meta WhatsApp Business Cloud API: a business number, separate from the
# personal account GladOS reads. It cannot reply to personal chats or groups,
# and free-form replies are limited to 24 hours after their last message.
# Get both from developers.facebook.com → your app → WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── Creative Engine (AdPilot → Creative engine) ───────────────────────────
# FOREPLAY_API_KEY=            # ad library: research, proof, duplicates (credits per call)
# MIOSA_API_KEY=               # Compute page: miosa auth token create --name glados
# ARCADS_BASIC_AUTH=           # Arcads UGC actors + direct models; base64 or the full "Basic …" value
# CREATIVE_ENGINE_DRY=1        # every Foreplay/Arcads/Claude call returns fixtures, 0 credits, badge shown
# CREATIVE_ENGINE_CREDIT_CAP=200  # per-session Arcads credit ceiling the cost gate refuses to exceed
# CREATIVE_ENGINE_STORE_DIR=   # override data/creative-engine (tests)
# CREATIVE_ENGINE_ASSET_DIR=   # override public/content-media/creative-engine (tests)
# AD_ENGINE_* names are still read as a fallback

# ── Content Lab (/lab, docs/projects/content-lab/v2/SPEC.md; 08.6.2) ──────
# Keys and connections (Setup > Keys writes every operator name below; values never leave the server)
# APIFY_API_TOKEN=             # Apify: your posts, tracked creators, discovery, X watch list, Radar actors (the only required key)
# OPENAI_API_KEY=              # optional: Whisper speech-to-text; without it, captions only
# LAB_YT_CLIENT_ID=            # YouTube Analytics: your Google Cloud web OAuth client id
# LAB_YT_CLIENT_SECRET=        # YouTube Analytics: its client secret
# LAB_YT_REFRESH_TOKEN=        # written by Connect YouTube (never pasted)
# LAB_YT_CHANNEL_ID=           # written by Connect YouTube
# LAB_YT_CONNECTED_AT=         # written by Connect YouTube
# LAB_YT_REDIRECT_URI=         # optional; default http://localhost:<port>/api/lab/oauth/youtube/callback
# LAB_IG_APP_ID=               # Instagram insights: your Meta app id (Instagram API with Instagram Login)
# LAB_IG_APP_SECRET=           # Instagram insights: its app secret
# LAB_IG_ACCESS_TOKEN=         # written by Connect Instagram, or pasted ("Paste a token instead")
# LAB_IG_TOKEN_EXPIRES_AT=     # written by Connect Instagram and each refresh
# LAB_IG_USER_ID=              # written by Connect Instagram
# LAB_IG_REDIRECT_URI=         # optional; default http://localhost:<port>/api/lab/oauth/instagram/callback
# PRODUCTHUNT_TOKEN=           # optional: Product Hunt developer token, a Radar source (personal use only under its API terms)
# GITHUB_TOKEN=                # optional: fine-grained token, no scopes; GitHub fake-star filter on Radar
# Spend caps, USD a month (provider plus line; 0 = off)
# LAB_APIFY_CAP_USD=98         # apify provider cap (the sum of its line caps)
# LAB_APIFY_SYNC_CAP_USD=46    # line: daily sync, discovery, Google Trends
# LAB_APIFY_SNAPSHOTS_CAP_USD=22  # line: your posts at fixed ages
# LAB_APIFY_X_CAP_USD=10       # line: your X posts
# LAB_APIFY_VERIFY_CAP_USD=1   # line: actor checks
# LAB_APIFY_RADAR_X_CAP_USD=15 # line: Radar X watch list
# LAB_APIFY_RADAR_TIKTOK_CAP_USD=3  # line: Radar TikTok Creative Center
# LAB_APIFY_RADAR_PRODUCTHUNT_CAP_USD=1  # line: Radar Product Hunt (actor path, without PRODUCTHUNT_TOKEN)
# LAB_STT_CAP_USD=13           # stt provider cap
# LAB_STT_CONTROLS_CAP_USD=3   # line: Whisper for comparison posts
# LAB_COMMENTS_CAP_USD=0       # comments provider (off at 0)
# LAB_DOWNLOADS_CAP_USD=0      # video downloads provider (off at 0)
# LAB_EMBED_CAP_USD=0          # OpenAI embeddings provider (off at 0)
# LAB_RUN_MAX_USD=3            # ceiling for one Apify run, sent as maxTotalChargeUsd
# Feature flags and Lab settings
# LAB_COMMENTS=                # 1 turns the comments line on (with a cap above 0)
# LAB_TIKTOK_DOWNLOADS=        # 1 turns TikTok video downloads on (with a cap above 0)
# LAB_TIKTOK_DOWNLOAD_PRICE_USD=  # optional override of the video-download event price; blank = the price book
# LAB_EMBED_PROVIDER=local     # local (free) or openai
# LAB_FRAMES=                  # 1 turns frame contact sheets on (needs ffmpeg and ffprobe)
# LAB_JUDGE=                   # 0 disables the pairwise hook judge; blank = on
# LAB_JUDGE_MODEL=             # optional --model for the judge; blank = the claude CLI default
# LAB_GROUNDING_CONTROL=0      # control-arm share of new drafts, 0 to 0.5
# LAB_COMMENT_SALT=            # written once by the Lab; never shown, never pasted
# LAB_X_POLL_MIN=120           # X watch list interval in minutes, minimum 60 (Setup > Schedule overrides it)
# LAB_BRIEF_TELEGRAM=          # 1 sends the morning brief through the Wizard (off by default)
# Operations
# GLADOS_TZ=                   # IANA zone for the Lab's local time; blank = this machine's zone
# LAB_DRY=1                    # every Apify, STT and LLM call returns fixtures, 0-cost dry ledger rows, no network
# LAB_FIXTURE_SCENARIO=full    # Filming only: full, thin, fresh, quiet, blocked, running or degraded
# LAB_SYNC_WAIT_MIN=20         # how long `npm run lab-sync -- sync` waits on Apify runs before leaving them to the next read
# LAB_DISSECT_MODEL=           # model passed to the claude CLI for dissection (--model); blank = the CLI default

# ── Agent health checks (optional; each falls back to a sensible default) ──
# BDPILOT_STATE=               # brand-deal daemon state file (default ~/.config/bdpilot/state.json)
# BDPILOT_BOT_URL=             # brand-deal approval bot link (https://t.me/<bot>); /brand-deals hides its Telegram link until set
# BRAND_DEALS_SKILL=           # drafting playbook skill (default ~/.claude/skills/brand-deals/SKILL.md)
# GSEND_BIN=                   # verified sender binary (default ~/bin/gsend)
# GSEND_QUEUE_PLIST=           # its queue daemon definition, if it has one
# GLADOS_AUTOMATION_DIR=       # scheduled-job folder (default ~/Sync/brain/Automation or ~/Desktop/brain/Automation)
# GLADOS_AGENT_JOB_PREFIX=     # launchd label prefix the job count looks for (default glados.agent.)
