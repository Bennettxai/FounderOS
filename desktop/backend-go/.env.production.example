# =============================================================================
# BusinessOS — Production Environment (TEMPLATE)
# Copy to .env on the prod host and fill in real values.
# Never commit a file containing real secrets.
#
# Categories (alphabetical within):
#   1. Server / deployment
#   2. Database
#   3. Redis
#   4. Security & internal auth
#   5. AI providers
#   6. OAuth integrations (login + per-app)
#   7. OptimalEngine / OSA
#   8. Sandbox / VM (Computer)
#   9. Carrier / NATS event bus
#  10. MIOSA platform
#  11. Email / push notifications
#  12. Search providers
#  13. Voice / media
#  14. Background jobs
#  15. Stripe (billing)
#  16. Templates / workspace
#
# Generated from canonical config_types.go + os.Getenv audit on 2026-04-29.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Server / deployment
# -----------------------------------------------------------------------------
ENVIRONMENT=production
GIN_MODE=release
DEPLOYMENT_MODE=cloud                                 # "local" | "cloud" — gates MIOSA JWT auth + Firecracker integrations
SERVER_PORT=8080
BASE_URL=https://api.businessos.dev
APP_URL=https://app.businessos.dev
FRONTEND_URL=https://app.businessos.dev
PRODUCTION_FRONTEND_URL=https://app.businessos.dev
BUSINESSOS_API_URL=https://api.businessos.dev
COOKIE_DOMAIN=.businessos.dev                         # leading dot → covers app.* and api.*
CLOUD_DOMAIN=businessos.dev
ALLOWED_ORIGINS=https://app.businessos.dev,https://businessos.dev
NODE_ID=                                              # optional — set per replica for tracing/sticky routing
OS_INSTANCE_ID=                                       # optional — opaque ID for cross-instance coordination


# -----------------------------------------------------------------------------
# 2. Database (Supabase)
# Pooler URL (port 6543) for app traffic. Direct (port 5432) for migrations only.
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_REQUIRED=true                                # fail-fast on boot if DB unreachable


# -----------------------------------------------------------------------------
# 3. Redis (Upstash)
# -----------------------------------------------------------------------------
REDIS_URL=rediss://default:[PASSWORD]@[HOST].upstash.io:6379
REDIS_PASSWORD=[PASSWORD]                             # must match the password embedded in REDIS_URL
REDIS_TLS_ENABLED=true                                # Upstash always TLS
REDIS_KEY_HMAC_SECRET=GENERATE_32_BYTE_RANDOM_KEY     # openssl rand -base64 32 — keys session cache HMAC
REDIS_ALLOW_FLUSH=false                               # NEVER true in prod


# -----------------------------------------------------------------------------
# 4. Security & internal auth
# -----------------------------------------------------------------------------
SECRET_KEY=GENERATE_64_BYTE_RANDOM_KEY                # openssl rand -base64 64 | tr -d '\n'
TOKEN_ENCRYPTION_KEY=GENERATE_32_BYTE_RANDOM_KEY      # openssl rand -base64 32 — encrypts OAuth tokens at rest
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080                     # 7 days
WEBHOOK_SIGNING_SECRET=GENERATE_32_BYTE_RANDOM_KEY    # outbound webhook HMAC
INTERNAL_API_SECRET=GENERATE_32_BYTE_RANDOM_KEY       # CRITICAL — required for /api/internal/* HMAC
INTERNAL_ALLOWED_IPS=                                 # comma-separated CIDRs that may hit internal endpoints (empty = HMAC-only)


# -----------------------------------------------------------------------------
# 5. AI providers
# AI_PROVIDER picks the default. Per-tenant overrides happen in the DB.
# -----------------------------------------------------------------------------
AI_PROVIDER=anthropic                                 # anthropic | openai | groq | xai | ollama_cloud | ollama_local
DEFAULT_MODEL=claude-sonnet-4-5-20250929
ENABLE_LOCAL_MODELS=false                             # cloud deploys disable Ollama-local

ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_BASE_URL=https://api.anthropic.com

OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-4o

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

XAI_API_KEY=
XAI_MODEL=grok-2-latest
XAI_BASE_URL=https://api.x.ai/v1

OLLAMA_MODE=cloud                                     # cloud | local
OLLAMA_LOCAL_URL=                                     # only used when OLLAMA_MODE=local
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_MODEL=

SUPERMEMORY_API_KEY=                                  # optional — long-term memory store


# -----------------------------------------------------------------------------
# 6. OAuth integrations
# -----------------------------------------------------------------------------
# Google login + per-integration (Calendar, Drive, Gmail, Docs)
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-REPLACE_ME
GOOGLE_REDIRECT_URI=https://api.businessos.dev/api/v1/auth/oauth/google/callback              # login flow
GOOGLE_INTEGRATION_REDIRECT_URI=https://api.businessos.dev/api/v1/integrations/google/callback # Calendar etc.
GOOGLE_CALENDAR_REDIRECT_URI=https://api.businessos.dev/api/v1/integrations/google_calendar/callback
GOOGLE_GMAIL_REDIRECT_URI=https://api.businessos.dev/api/v1/integrations/google_gmail/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://api.businessos.dev/api/v1/integrations/slack/callback

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://api.businessos.dev/api/v1/integrations/notion/callback

HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=https://api.businessos.dev/api/v1/integrations/hubspot/callback

LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=https://api.businessos.dev/api/v1/integrations/linear/callback
LINEAR_WEBHOOK_SECRET=                                # for verifying inbound Linear webhooks

CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
CLICKUP_REDIRECT_URI=https://api.businessos.dev/api/v1/integrations/clickup/callback

AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
AIRTABLE_REDIRECT_URI=https://api.businessos.dev/api/v1/integrations/airtable/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://api.businessos.dev/api/v1/integrations/microsoft/callback


# -----------------------------------------------------------------------------
# 7. OptimalEngine / OSA
# In cloud: OptimalEngine runs INSIDE the Computer VM, NOT in the API process.
# Set OPTIMAL_ENABLED=false here; the per-VM envd handles it.
# -----------------------------------------------------------------------------
OPTIMAL_ENABLED=false
OPTIMAL_ENGINE_URL=                                   # only set when bridging to a remote engine
OPTIMAL_ENGINE_API_KEY=                               # required when OptimalEngine auth is enabled
OPTIMAL_MODE=cloud                                    # cloud | local | hybrid
OPTIMAL_MODULES=
OPTIMAL_CAPABILITIES=
OPTIMAL_TEMPLATE_TYPE=
OPTIMAL_REMOTE_URL=
OPTIMAL_HEARTBEAT_INTERVAL=30                         # seconds
OPTIMAL_COOKIE_JAR=

OSA_ENABLED=true
OSA_BASE_URL=https://api.businessos.dev
OSA_MODE=cloud
OSA_SHARED_SECRET=GENERATE_32_BYTE_RANDOM_KEY
OSA_TIMEOUT=120                                       # seconds
OSA_MAX_RETRIES=3
OSA_RETRY_DELAY=2                                     # seconds
OSA_WEBHOOK_TIMEOUT_SECONDS=30
OSA_ALLOW_UNSIGNED_WEBHOOKS=false                     # NEVER true in prod
OSA_DEPLOYMENT_ROOT=
OSA_WORKSPACE_PATH=


# -----------------------------------------------------------------------------
# 8. Sandbox / VM (Computer module)
# -----------------------------------------------------------------------------
SANDBOX_DEFAULT_CPU=2
SANDBOX_DEFAULT_MEMORY=2048                           # MB
SANDBOX_MAX_PER_USER=3
SANDBOX_MAX_TOTAL_MEMORY=16384                        # MB across all of a user's VMs
SANDBOX_MAX_TOTAL_STORAGE=51200                       # MB
SANDBOX_PORT_MIN=10000
SANDBOX_PORT_MAX=11000
BUSINESSOS_INIT_SCRIPT=                               # path to init.sh inside VM (default fine)
DISABLE_APP_DEPLOYMENT=false
E2B_API_KEY=                                          # optional — legacy E2B fallback path


# -----------------------------------------------------------------------------
# 9. Carrier / NATS (event bus)
# -----------------------------------------------------------------------------
CARRIER_ENABLED=false                                 # turn on once Carrier replicas are deployed
CARRIER_AMQP_URL=
CARRIER_PREFETCH=32
CARRIER_SEND_TIMEOUT=10                               # seconds
NATS_ENABLED=false
NATS_URL=
NATS_TTL_HOURS=72


# -----------------------------------------------------------------------------
# 10. MIOSA (platform service auth)
# -----------------------------------------------------------------------------
MIOSA_API_URL=https://api.miosa.ai
MIOSA_CLOUD_URL=https://api.miosa.ai
MIOSA_API_KEY=PLATFORM_SERVICE_JWT_HERE               # JWT issued by MIOSA platform
MIOSA_JWT_PUBLIC_KEY=                                 # PEM public key for verifying inbound MIOSA JWTs
MIOSA_TENANT_ID=                                      # this BO instance's tenant UUID


# -----------------------------------------------------------------------------
# 11. Email / push
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL=hello@businessos.dev
RESEND_FROM_NAME=BusinessOS
EMAIL_LOGO_URL=https://app.businessos.dev/logo.png
SUPPORT_EMAIL=support@businessos.dev

# Web Push (browser notifications) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:support@businessos.dev


# -----------------------------------------------------------------------------
# 12. Search providers
# -----------------------------------------------------------------------------
SEARCH_PROVIDER=brave                                 # brave | serper | tavily
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=


# -----------------------------------------------------------------------------
# 13. Voice / media
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5

CLIP_PROVIDER=local                                   # local | api
CLIP_LOCAL_URL=                                       # if running CLIP embeddings locally
CLIP_API_KEY=                                         # if using a hosted CLIP API


# -----------------------------------------------------------------------------
# 14. Background jobs (intervals + batch sizes)
# Defaults conservative; raise batch sizes if your DB can take it.
# -----------------------------------------------------------------------------
APP_PROFILER_SYNC_JOB_ENABLED=true
APP_PROFILER_SYNC_JOB_INTERVAL_MINUTES=15
APP_PROFILER_SYNC_JOB_BATCH_SIZE=50

BEHAVIOR_PATTERNS_JOB_ENABLED=true
BEHAVIOR_PATTERNS_JOB_INTERVAL_MINUTES=60
BEHAVIOR_PATTERNS_JOB_USER_BATCH_SIZE=25

CONVERSATION_SUMMARY_JOB_ENABLED=true
CONVERSATION_SUMMARY_JOB_INTERVAL_MINUTES=10
CONVERSATION_SUMMARY_JOB_BATCH_SIZE=20
CONVERSATION_SUMMARY_JOB_MAX_MESSAGES=200


# -----------------------------------------------------------------------------
# 15. Stripe (billing)
# Use sk_live_* in production. Webhook secret from Stripe Dashboard > Webhooks.
# (NOTE: not yet read by the Go config loader — wired via os.Getenv in handlers
# once billing ships. Set them now to avoid a follow-up deploy.)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_PRO=price_REPLACE_ME
STRIPE_PRICE_GROWTH=price_REPLACE_ME
STRIPE_PRICE_BUSINESS=price_REPLACE_ME


# -----------------------------------------------------------------------------
# 16. Templates / workspace
# -----------------------------------------------------------------------------
SYNC_TEMPLATES_ON_STARTUP=true
TEMPLATES_DIR=/app/templates                          # path inside the container
WORKSPACE_PATH=/app/workspace
