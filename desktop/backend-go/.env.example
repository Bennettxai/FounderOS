DATABASE_URL=postgres://localhost:5432/business_os?sslmode=disable
SECRET_KEY=generate-a-random-64-byte-key-here
TOKEN_ENCRYPTION_KEY=generate-a-random-32-byte-key-here
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_KEY_HMAC_SECRET=generate-a-random-32-byte-key-here
REDIS_TLS_ENABLED=false
SERVER_PORT=8001
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,app://localhost
AI_PROVIDER=ollama_local
OLLAMA_LOCAL_URL=http://localhost:11434
DEFAULT_MODEL=llama3.2:3b
OSA_MODE=local
OSA_ENABLED=false
ENABLE_LOCAL_MODELS=true
CONTAINER_MANAGER_ENABLED=false
SANDBOX_ENABLED=false
# OptimalEngine runtime — canonical Elixir engine.
#
# Start it from the repo root with:
#   make optimal-engine
#
# BusinessOS reverse-proxies /api/optimal/* and /api/optimal-engine/* to this
# service. If OPTIMAL_ENGINE_URL is blank, those routes return 503 with setup
# guidance; there is no in-process Go fallback.
OPTIMAL_ENGINE_URL=http://127.0.0.1:4200
# Required only when the engine runs with OPTIMAL_AUTH_REQUIRED=true.
# Mint with: cd optimal-engine && mix optimal.auth env --name "BusinessOS" --workspace "*"
OPTIMAL_ENGINE_API_KEY=
CARRIER_ENABLED=false
NATS_ENABLED=false
OSA_WEBHOOK_SECRET=change-this-in-production

# Cloud connection (optional — set these to connect to BusinessOS Cloud)
MIOSA_API_URL=
MIOSA_API_KEY=

# ── TEAM SETUP (Agency Miosa) ────────────────────────────────────────────────
# Google sign-in (local dev). Ask Roberto for these — same client as cloud, its
# localhost redirect URIs are already authorized so Google login works locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Instagram / Meta connector for ContentOS insights and publishing.
# Requires an Instagram professional account connected to a Facebook Page and a
# Meta app with the needed Instagram Graph API permissions.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8001/api/integrations/instagram/callback
# Optional aliases if Roberto's Meta app is named this way instead.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8001/api/integrations/instagram/callback

# AI provider for real models (swap ollama_local above for anthropic + a key).
# Ask Roberto for a key, or use your own.
# AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Your OWN local knowledge/workspace files (the folder your Optimal Engine indexes).
# Leave blank to read the shared cloud copy instead of local files.
KNOWLEDGE_WORKSPACES_ROOT=

# Optional override for the local WhatsApp MCP history database.
# When blank, desktop installs auto-detect the canonical whatsapp-mcp path.
# BusinessOS opens this source read-only and does not route chats to a workspace automatically.
WHATSAPP_MESSAGES_DB=

# The BusinessOS cloud backend — lets your local app sync/pull shared data.
BUSINESSOS_CLOUD_URL=https://businessos.dev
